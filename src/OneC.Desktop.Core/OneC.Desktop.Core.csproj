<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app's non-UI half: base store, supervisor launcher, edge client. Plain
       net9.0 so the test project can drive it without WinUI. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OneC.Desktop.Services</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneC.Cloud\OneC.Cloud.csproj" />
  </ItemGroup>
</Project>
