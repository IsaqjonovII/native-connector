<Project Sdk="Microsoft.NET.Sdk">
  <!-- AIBA cloud account for the desktop app: login, token refresh, companies, linking an
       infobase to a company (specs/2026-09-30-auth-and-cloud-link.md). No UI, no COM, so the
       tests drive it against the local CloudStub. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
</Project>
