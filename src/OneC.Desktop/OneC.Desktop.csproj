<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build settings proven on this machine by the WinUI prototype: WindowsAppSDK 2.4.0 with
       BuildTools 10.0.26100.4654 (1.6/1.7 failed with MSB4062 ExpandPriContent), unpackaged,
       self-contained. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OneC.Desktop</RootNamespace>
    <AssemblyName>AIBA.Connector</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>CA1416</NoWarn>
    <!-- The exe / taskbar / Alt+Tab icon: the AIBA Connector logo (same as the old Connector). -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also loaded at run time: the window caption and the notification-area icon. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The header logo. -->
    <Content Include="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Startup splash: the mobile app's splash_fast.gif (600x600, 75 frames, 1.5 s) and its final frame. -->
    <Content Include="Assets\Splash.gif" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SplashEnd.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup>
    <!-- No COM, no 1C: the app talks only to the supervisor's HTTP edge (DECISIONS D28).
         Everything that is not UI lives in OneC.Desktop.Core so it can be tested. -->
    <ProjectReference Include="..\OneC.Desktop.Core\OneC.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
