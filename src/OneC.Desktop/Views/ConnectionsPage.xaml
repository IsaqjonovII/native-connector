<Page
    x:Class="OneC.Desktop.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:OneC.Desktop.Controls">

    <Grid Padding="28,20,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="1C connections" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="The bases in 1C's own list on this computer. Connect the ones AIBA should read." />
        </StackPanel>

        <!-- As the old Connector's "1C bazalarni boshqarish": the list comes from 1C itself, the
             type is read from it, nothing is typed in by hand. Filter by state on the left, search
             and refresh on the right; each row carries its own actions. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Filter" VerticalAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                <SelectorBarItem x:Name="FilterAll" Text="All" IsSelected="True" />
                <SelectorBarItem x:Name="FilterConnected" Text="Connected" />
                <SelectorBarItem x:Name="FilterNotConnected" Text="Not connected" />
            </SelectorBar>
            <TextBox x:Name="Search" Grid.Column="1" Width="280" PlaceholderText="Search by name or folder"
                     VerticalAlignment="Center" TextChanged="Search_TextChanged" />
            <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center"
                    Height="32" Width="36" Padding="0" AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Read 1C's list of bases again">
                <FontIcon Glyph="&#xE72C;" FontSize="15" />
            </Button>
        </Grid>

        <InfoBar x:Name="Message" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Padding="0">
            <c:ResultTable x:Name="Table" />
        </Border>
    </Grid>
</Page>
