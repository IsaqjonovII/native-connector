<Page
    x:Class="OneC.Desktop.Views.InfobasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:OneC.Desktop.Controls">

    <Grid Padding="28,20,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Infobases" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitleStyle}"
                       Text="The 1C databases of the company chosen at the top." />
        </StackPanel>

        <!-- As in the old Connector: the company comes from the header, "Add infobase" picks one of
             this computer's 1C connections and adds it to that company. -->
        <!-- Deleting lives in each row's "…" menu (it asks first and says it can't be undone). -->
        <Button x:Name="AddButton" Grid.Row="1" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <TextBlock Text="Add infobase" />
            </StackPanel>
        </Button>

        <InfoBar x:Name="Message" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <!-- One card per infobase (a company has a handful): who, sync, this computer, next step. -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <!-- Add/delete animation is switched on in code once the page is shown, so coming
                     back to the page doesn't replay it over every card. -->
                <StackPanel x:Name="Cards" Spacing="8" />
            </ScrollViewer>
            <StackPanel x:Name="Empty" Spacing="6" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE8F1;" FontSize="32" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="EmptyText" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="EmptyButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Click="EmptyButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
