<Page
    x:Class="OneC.Desktop.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:OneC.Desktop.Controls">

    <Grid Padding="28,20,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Resources" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="How much of this computer the connector uses right now. Updates every 2 seconds." />
        </StackPanel>

        <!-- Totals: wrap on narrow windows. -->
        <VariableSizedWrapGrid Grid.Row="1" Orientation="Horizontal" ItemWidth="210" ItemHeight="96">
            <Border Style="{StaticResource PanelStyle}" Padding="14,10,14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="TotalRam" Text="–" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Text="Memory in use" Style="{StaticResource MetricLabelStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Padding="14,10,14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="TotalSessions" Text="–" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Text="Open connections to 1C" Style="{StaticResource MetricLabelStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Padding="14,10,14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="TotalHosts" Text="–" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Text="1C engines running" Style="{StaticResource MetricLabelStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Padding="14,10,14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="TotalRestarts" Text="–" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Text="Automatic restarts" Style="{StaticResource MetricLabelStyle}" />
                </StackPanel>
            </Border>
        </VariableSizedWrapGrid>

        <TextBlock Grid.Row="2" Text="Parts of the connector" Style="{StaticResource SectionTitleStyle}" />
        <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Padding="0">
            <c:ResultTable x:Name="ProcessTable" EmptyText="The 1C engine is not running." />
        </Border>

        <TextBlock Grid.Row="4" Text="Connections to 1C" Style="{StaticResource SectionTitleStyle}" />
        <Border Grid.Row="5" Style="{StaticResource PanelStyle}" Padding="0">
            <c:ResultTable x:Name="PoolTable" EmptyText="No open connections. One opens when an infobase is used and closes after 5 quiet minutes." />
        </Border>
    </Grid>
</Page>
