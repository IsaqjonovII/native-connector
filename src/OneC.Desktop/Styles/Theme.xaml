<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral near-black / white surfaces (as aiba-next). Buttons, selection and focus use the
         user's Windows accent colour, untouched (user, 2026-09-30: AIBA has no single brand
         colour; no gradients). Status pills keep fixed semantic colours. Every surface sets its
         own background AND its own text colour (house rule: own both sides). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F7F9" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SubtleRowBrush" Color="#0F172A" Opacity="0.03" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#0F172A" Opacity="0.04" />
            <SolidColorBrush x:Key="DividerBrush" Color="#0F172A" Opacity="0.08" />
            <!-- Status inks (text on page and on the pill fill clear 4.5:1) and pill fills. -->
            <SolidColorBrush x:Key="OkBrush" Color="#15803D" />
            <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
            <SolidColorBrush x:Key="BadBrush" Color="#B91C1C" />
            <!-- The accent's own dark / light shade, named per theme: an aliased accent brush resolved
                 for the Windows theme and read faint when the app is switched to the other one. -->
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#64748B" />
            <SolidColorBrush x:Key="OkPillBrush" Color="#16A34A" Opacity="0.12" />
            <SolidColorBrush x:Key="WarnPillBrush" Color="#D97706" Opacity="0.14" />
            <SolidColorBrush x:Key="BadPillBrush" Color="#DC2626" Opacity="0.12" />
            <SolidColorBrush x:Key="InfoPillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="NeutralPillBrush" Color="#64748B" Opacity="0.12" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111113" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1A1D" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#292A2D" />
            <SolidColorBrush x:Key="SubtleRowBrush" Color="#FFFFFF" Opacity="0.03" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#FFFFFF" Opacity="0.045" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="BadBrush" Color="#F87171" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="OkPillBrush" Color="#22C55E" Opacity="0.14" />
            <SolidColorBrush x:Key="WarnPillBrush" Color="#F59E0B" Opacity="0.16" />
            <SolidColorBrush x:Key="BadPillBrush" Color="#EF4444" Opacity="0.16" />
            <SolidColorBrush x:Key="InfoPillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
            <SolidColorBrush x:Key="NeutralPillBrush" Color="#A1A1AA" Opacity="0.12" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- A panel, not a SaaS card: 8 px corners (aiba-next radius), hairline border, no shadow. -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- A menu kept inside the window loses its acrylic backdrop and turns see-through: solid panel. -->
    <Style x:Key="SolidMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
    </Style>

    <!-- Type scale: Windows' own (Title 28, Subtitle 20, Body 14). Nothing a person reads is below 14 px. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CellTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
