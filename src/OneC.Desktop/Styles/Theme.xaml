<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tokens carried over from the WinUI prototype. Every surface sets its own background
         AND its own text colour (house rule: own both sides of the contrast). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F5" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DADAE0" />
            <SolidColorBrush x:Key="SubtleRowBrush" Color="#000000" Opacity="0.03" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#000000" Opacity="0.045" />
            <SolidColorBrush x:Key="DividerBrush" Color="#000000" Opacity="0.09" />
            <SolidColorBrush x:Key="OkBrush" Color="#1E7F4F" />
            <SolidColorBrush x:Key="WarnBrush" Color="#9A6200" />
            <SolidColorBrush x:Key="BadBrush" Color="#B3261E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C21" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#25252B" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="SubtleRowBrush" Color="#FFFFFF" Opacity="0.035" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#FFFFFF" Opacity="0.06" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FFFFFF" Opacity="0.09" />
            <SolidColorBrush x:Key="OkBrush" Color="#5CC98E" />
            <SolidColorBrush x:Key="WarnBrush" Color="#E3B341" />
            <SolidColorBrush x:Key="BadBrush" Color="#F2766B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- A panel, not a SaaS card: 6 px corners, hairline border, no drop shadow. -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CellTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
