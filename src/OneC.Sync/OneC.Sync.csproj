<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>CA1416</NoWarn>
    <RootNamespace>OneC.Sync</RootNamespace>
  </PropertyGroup>
  <!-- The Connector's sync engine (SYNC_ENGINE_ARCHITECTURE.md, D42). Runs in the Supervisor: no
       COM — 1C is reached through the host's pipe ops, the backend only through IBackendSyncTarget. -->
  <ItemGroup>
    <ProjectReference Include="..\OneC.SyncState\OneC.SyncState.csproj" />
    <ProjectReference Include="..\OneC.Sync.Abstractions\OneC.Sync.Abstractions.csproj" />
    <ProjectReference Include="..\OneC.EventLog\OneC.EventLog.csproj" />
  </ItemGroup>
</Project>
