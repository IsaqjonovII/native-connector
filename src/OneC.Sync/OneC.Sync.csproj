<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <!-- 1C → cloud sync (milestone 5.9, D39). No COM: it reads through the supervisor's pipe
       ops and change feed, and uploads over HTTP. The stub backend lives here too, so tests
       and the supervisor's `sync` mode use the same contract. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneC.EventLog\OneC.EventLog.csproj" />
  </ItemGroup>
</Project>
