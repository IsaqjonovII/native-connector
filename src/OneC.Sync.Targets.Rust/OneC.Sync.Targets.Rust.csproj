<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- IBackendSyncTarget over the Rust onec module's /api/sync/v1 (RUST_SYNC_CONTRACT.md) — the
       intended permanent target. Loopback/local only until R7 and the developer's go. -->
  <ItemGroup>
    <ProjectReference Include="..\OneC.Sync.Abstractions\OneC.Sync.Abstractions.csproj" />
  </ItemGroup>
</Project>
