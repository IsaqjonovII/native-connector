<Window
    x:Class="AibaShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: identity on the left, machine/environment on the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AIBA Connector" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource TableHeaderBrush}" CornerRadius="3" Padding="6,1,6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="EnvChip" Text="PRODUCTION" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="v2.0.0-proto" FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2FA968" VerticalAlignment="Center" />
                    <TextBlock x:Name="MachineText" Text="WIN-11-2070 · agent online" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="1" Height="16" Background="{ThemeResource DividerBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="S. Barakayev · SIGNUM SAVDO MCHJ" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="228"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="Nav_SelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="1C" Tag="onec" IsExpanded="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                    <muxc:NavigationViewItem.MenuItems>
                        <muxc:NavigationViewItem Content="Information Bases" Tag="bases">
                            <muxc:NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE968;" />
                            </muxc:NavigationViewItem.Icon>
                        </muxc:NavigationViewItem>
                        <muxc:NavigationViewItem Content="Sync" Tag="sync">
                            <muxc:NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE895;" />
                            </muxc:NavigationViewItem.Icon>
                        </muxc:NavigationViewItem>
                        <muxc:NavigationViewItem Content="Documents" Tag="documents">
                            <muxc:NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </muxc:NavigationViewItem.Icon>
                        </muxc:NavigationViewItem>
                        <muxc:NavigationViewItem Content="Reports" Tag="reports">
                            <muxc:NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </muxc:NavigationViewItem.Icon>
                        </muxc:NavigationViewItem>
                    </muxc:NavigationViewItem.MenuItems>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Banks" Tag="banks">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Processes" Tag="processes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Logs" Tag="logs">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel Margin="14,0,14,10" Spacing="6">
                    <Border Style="{StaticResource PanelStyle}" Padding="10,8,10,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ADAPTER" FontSize="10" CharacterSpacing="80" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#2FA968" VerticalAlignment="Center" />
                                <TextBlock x:Name="AdapterStatusText" Text="active · :55899" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Margin="0" />
        </muxc:NavigationView>

        <!-- Status strip: the desktop-app tell that this is an operations tool. -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource PanelBackgroundBrush}">
            <Grid Padding="14,0,14,0">
                <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBases" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusWorkers" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusQueue" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusBanks" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusCpu" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusRam" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusUptime" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
