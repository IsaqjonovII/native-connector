<Page
    x:Class="AibaShell.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Processes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Refresh" Label="Restart" Click="Restart_Click" />
                <AppBarButton Icon="Stop" Label="Stop" Click="Stop_Click" />
                <AppBarButton Icon="Document" Label="View logs" Click="Logs_Click" />
                <AppBarSeparator />
                <AppBarButton Icon="Repair" Label="Restart all workers" Click="RestartAll_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Border Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource TableHeaderBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="16,9,16,9">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="PID" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="UPTIME" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="RAM" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="CPU" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="7" Text="PORT" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="8" Text="RESTARTS" Style="{StaticResource TableHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="ProcList" Style="{StaticResource DenseListViewStyle}" Padding="0,2,0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="16,0,16,0" />
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:ProcessNode">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                        <Border Width="{x:Bind IndentWidth}" />
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="9" Opacity="0.4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Visibility="{x:Bind ShowBranch, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource CellSecondaryTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PidText, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{x:Bind UptimeText, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind MemoryText, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind CpuText, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind PortText}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind Restarts, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,8,16,8">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock x:Name="TotalsText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SupervisorText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
