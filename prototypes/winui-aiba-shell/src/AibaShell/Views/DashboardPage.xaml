<Page
    x:Class="AibaShell.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="1" HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Sync" Label="Sync all" Click="SyncAll_Click" />
                <AppBarButton Icon="Refresh" Label="Reconnect" Click="Reconnect_Click" />
                <AppBarSeparator />
                <AppBarButton Icon="Repair" Label="Heal ext-conn" Click="Heal_Click" />
            </CommandBar>
        </Grid>

        <muxc:InfoBar x:Name="AttentionBar" Grid.Row="1" Margin="24,0,24,8"
                      Severity="Error" IsOpen="True" IsClosable="True"
                      Title="Production-01 cannot attach"
                      Message="COM client 8.3.24 vs server 8.3.25. Register comcntr 8.3.25 or pin comVersion for this base.">
            <muxc:InfoBar.ActionButton>
                <Button Content="Open base" Click="OpenProblemBase_Click" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <ScrollViewer Grid.Row="2" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Metric row -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1C -->
                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="1C STATUS" Style="{StaticResource PanelTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="BasesValue" Style="{StaticResource MetricValueStyle}" />
                                <TextBlock Text="bases" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Spacing="5">
                                <Grid>
                                    <TextBlock Text="Active workers" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="WorkersValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Queue depth" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="QueueValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Last sync" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="LastSyncValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System -->
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM" Style="{StaticResource PanelTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="CpuValue" Style="{StaticResource MetricValueStyle}" />
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <muxc:ProgressBar x:Name="CpuBar" Margin="0,8,0,0" Maximum="100" Height="3" />
                            <StackPanel Margin="0,10,0,0" Spacing="5">
                                <Grid>
                                    <TextBlock Text="RAM" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="RamValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Processes" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="ProcValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="App uptime" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="UptimeValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sync -->
                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="SYNC" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="SyncBaseValue" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="SyncObjectValue" Style="{StaticResource MetricLabelStyle}" TextTrimming="CharacterEllipsis" />
                            <muxc:ProgressBar x:Name="SyncBar" Margin="0,10,0,6" Maximum="100" Height="4" />
                            <StackPanel Spacing="5">
                                <Grid>
                                    <TextBlock Text="Throughput" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="SyncRateValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Rows processed" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="SyncRowsValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="ETA" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="SyncEtaValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Banks -->
                    <Border Grid.Column="3" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="BANKS" Style="{StaticResource PanelTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="BanksValue" Style="{StaticResource MetricValueStyle}" />
                                <TextBlock Text="connected" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Spacing="5">
                                <Grid>
                                    <TextBlock Text="Need attention" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="BankWarnValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Last statement" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="BankLastValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Signing daemon" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="ePass2003 ok" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activity + at-a-glance base list -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="16,14,16,6">
                        <StackPanel>
                            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource PanelTitleStyle}" />
                            <ListView x:Name="ActivityList" SelectionMode="None" Padding="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="330">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0,4,0,4" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:ActivityItem">
                                        <Grid ColumnSpacing="12" Padding="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontSize="14" Glyph="{x:Bind Glyph}"
                                                      Foreground="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Title}" FontSize="13" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11.5"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind AtText}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="16,14,16,6">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="BASES" Style="{StaticResource PanelTitleStyle}" />
                                <HyperlinkButton Content="Open list" HorizontalAlignment="Right" Padding="4,0,4,0"
                                                 Margin="0,-6,0,0" FontSize="12" Click="OpenBases_Click" />
                            </Grid>
                            <ListView x:Name="BaseMiniList" SelectionMode="None" Padding="0" MaxHeight="330"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0,2,0,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:InfoBase">
                                        <Grid ColumnSpacing="10" Padding="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" />
                                                <TextBlock Text="{x:Bind CurrentObject, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind RowsPerSecondText, Mode=OneWay}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
