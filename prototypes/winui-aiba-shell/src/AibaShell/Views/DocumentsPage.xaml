<Page
    x:Class="AibaShell.Views.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Documents" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Send" Label="Retry failed" Click="Retry_Click" />
                <AppBarButton Icon="Accept" Label="Post drafts" Click="Post_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Border Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource TableHeaderBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="16,9,16,9">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.6*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NUMBER" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="BASE" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="COUNTERPARTY" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="STATE" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="MARKER" Style="{StaticResource TableHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="DocList" Style="{StaticResource DenseListViewStyle}" Padding="0,2,0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="16,0,16,0" />
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:DocumentRow">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Number}" Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Type}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Base}" Style="{StaticResource CellSecondaryTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Counterparty}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Amount}" Style="{StaticResource MonoTextStyle}"
                                               HorizontalAlignment="Right" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{x:Bind State}" Style="{StaticResource CellTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="{x:Bind Marker}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
