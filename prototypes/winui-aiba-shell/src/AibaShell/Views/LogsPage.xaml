<Page
    x:Class="AibaShell.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarToggleButton x:Name="PauseButton" Icon="Pause" Label="Pause" Click="Pause_Click" />
                <AppBarToggleButton x:Name="AutoScrollButton" Icon="Download" Label="Auto-scroll" IsChecked="True" />
                <AppBarSeparator />
                <AppBarButton Icon="Copy" Label="Copy all" Click="Copy_Click" />
                <AppBarButton Icon="Save" Label="Export" Click="Export_Click" />
                <AppBarButton Icon="Delete" Label="Clear" Click="Clear_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Padding="24,0,24,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search messages"
                            QueryIcon="Find" TextChanged="SearchBox_TextChanged" />

            <ComboBox Grid.Column="1" x:Name="LevelBox" MinWidth="130" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All levels" Tag="all" />
                <ComboBoxItem Content="Debug+" Tag="debug" />
                <ComboBoxItem Content="Info+" Tag="info" />
                <ComboBoxItem Content="Warning+" Tag="warning" />
                <ComboBoxItem Content="Error only" Tag="error" />
            </ComboBox>

            <ComboBox Grid.Column="2" x:Name="ComponentBox" MinWidth="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All components" Tag="all" />
                <ComboBoxItem Content="App" Tag="App" />
                <ComboBoxItem Content="Router" Tag="Router" />
                <ComboBoxItem Content="1C" Tag="1C" />
                <ComboBoxItem Content="COM" Tag="COM" />
                <ComboBoxItem Content="Sync" Tag="Sync" />
                <ComboBoxItem Content="Reports" Tag="Reports" />
                <ComboBoxItem Content="Bank" Tag="Bank" />
                <ComboBoxItem Content="Worker-3" Tag="Worker-3" />
            </ComboBox>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#2FA968" VerticalAlignment="Center" />
                    <TextBlock x:Name="LiveText" Text="live" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Border Style="{StaticResource PanelStyle}" Padding="0" Background="{ThemeResource ConsoleBackgroundBrush}">
                <ListView x:Name="LogList" SelectionMode="Extended" Padding="8,6,8,6"
                          ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,1,8,1" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" Style="{StaticResource MonoTextStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind LevelText}" Style="{StaticResource MonoTextStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind Level, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ComponentText}" Style="{StaticResource MonoTextStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Message}" Style="{StaticResource MonoTextStyle}"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
