<Page
    x:Class="AibaShell.Views.BanksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Banks" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Sync" Label="Pull statements" Click="Pull_Click" />
                <AppBarButton Icon="Permissions" Label="Keys" Click="Keys_Click" />
            </CommandBar>
        </Grid>

        <muxc:InfoBar Grid.Row="1" x:Name="AttentionBar" Margin="24,0,24,8" Severity="Warning" IsOpen="True" IsClosable="True"
                      Title="2 banks need an operator"
                      Message="SQB session expired and Ipoteka is returning 403 from the statement endpoint. Signing runs through the central E-IMZO daemon; a person must re-auth." />

        <ScrollViewer Grid.Row="2" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="BankRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="330" MinItemHeight="128" MinColumnSpacing="12" MinRowSpacing="12"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:BankConnection">
                        <Border Style="{StaticResource PanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28" CornerRadius="5"
                                                Background="{ThemeResource TableHeaderBrush}">
                                            <TextBlock Text="{x:Bind Code}" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind AccountsText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock Text="{x:Bind LastSyncText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Reconnect" FontSize="12" Padding="10,4,10,4" Click="Reconnect_Click" />
                                        <Button Content="Statements" FontSize="12" Padding="10,4,10,4" Click="Statements_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
