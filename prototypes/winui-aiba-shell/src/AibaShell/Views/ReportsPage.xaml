<Page
    x:Class="AibaShell.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:AibaShell.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="Reports" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Play" Label="Build" Click="Build_Click" />
                <AppBarButton Icon="Download" Label="Export xlsx" Click="Export_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Border Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource TableHeaderBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="16,9,16,9">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="REPORT" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="KIND" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="BASE" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="PERIOD" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="BUILD" Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="STATE" Style="{StaticResource TableHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="ReportList" Style="{StaticResource DenseListViewStyle}" Padding="0,2,0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="16,0,16,0" />
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:ReportRow">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource CellTextStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource CellSecondaryTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Base}" Style="{StaticResource CellSecondaryTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Period}" Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Built}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{x:Bind State}" Style="{StaticResource CellTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
