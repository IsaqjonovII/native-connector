<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- S15: kill the engine at random points while 1C keeps changing; at the end the backend must
       equal 1C exactly. The "1C" is a file-backed fake with a real-format event log; the target is
       the isolated local backend/1c (persistent), so nothing survives a kill that should not. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\OneC.Sync\OneC.Sync.csproj" />
    <ProjectReference Include="..\..\..\src\OneC.Sync.Targets.Python\OneC.Sync.Targets.Python.csproj" />
  </ItemGroup>
</Project>
